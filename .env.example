# Safe local default. Environment variables are supplied by the shell/deployment;
# this repository does not load this file automatically.
APP_ENV=development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=change-me-development-only

# HTTPS/browser security. In production, Django redirects to HTTPS. Set proxy
# trust only when a trusted TLS terminator strips client forwarding headers and
# sets X-Forwarded-Proto itself. CSRF origins are comma-separated full origins.
TRUST_PROXY_SSL_HEADER=false
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Cache/abuse controls. Development uses local memory. Production authentication
# controls require CACHE_BACKEND=redis and a shell-supplied Redis URL.
CACHE_BACKEND=locmem
REDIS_URL=redis://:your-password-here@127.0.0.1:6379/0
TRUST_PROXY_CLIENT_IP=false

# Database: sqlite is the development fallback. PostgreSQL is mandatory when
# APP_ENV=production.
DB_BACKEND=sqlite
POSTGRES_DB=tilecompany_dev
POSTGRES_USER=tilecompany_app
POSTGRES_PASSWORD=your-password-here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# PostgreSQL network hardening. A local socket/private local database may leave
# TLS fields empty. Remote production databases should prefer verify-full with
# a deployment-supplied CA path; never commit the certificate or credentials.
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=

# Development Mailpit defaults are used when these are omitted. Production must
# supply a non-development backend, non-local host, sender, and exactly one TLS/SSL mode.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=your-password-here
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=TileStore <no-reply@tilestore.local>
SERVER_EMAIL=TileStore <no-reply@tilestore.local>
SITE_URL=http://localhost:8000

# Static collection. Keep this deployment-owned location outside source/static;
# the conventional default is <project>/staticfiles.
STATIC_ROOT=

# Payment: development defaults to sandbox and local simulated provider behavior.
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-uuid-here
ZARINPAL_SANDBOX=true
ZARINPAL_DEVELOPMENT_AUTO_SUCCESS=true
MOCK_PAYMENT_SIMULATION_ENABLED=true

# SMS stays disabled unless a real provider is configured. Production SMS requires
# a shared cache and must not use the memory or console backend.
SMS_ENABLED=false
SMS_OTP_LOGIN_ENABLED=false
SMS_BACKEND=accounts.sms.DisabledSmsBackend
SMS_DEFAULT_REGION=IR
