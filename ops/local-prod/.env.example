# Copy this file to .env and replace every placeholder with a unique local-only value.
# Do not reuse the Windows PostgreSQL password or any production credential.
LOCALPROD_POSTGRES_DB=replace_with_localprod_database_name
LOCALPROD_POSTGRES_BOOTSTRAP_USER=replace_with_localprod_bootstrap_admin_user
LOCALPROD_POSTGRES_BOOTSTRAP_PASSWORD=replace_with_unique_localprod_bootstrap_password
LOCALPROD_POSTGRES_MIGRATION_USER=replace_with_localprod_migration_user
LOCALPROD_POSTGRES_MIGRATION_PASSWORD=replace_with_unique_localprod_migration_password
LOCALPROD_POSTGRES_RUNTIME_USER=replace_with_localprod_runtime_user
LOCALPROD_POSTGRES_RUNTIME_PASSWORD=replace_with_unique_localprod_runtime_password
# Dedicated local-only Django test/performance identity. Never use this in web,
# nginx, or normal local-production service environments.
LOCALPROD_POSTGRES_TEST_USER=tilecompany_localprod_test
LOCALPROD_POSTGRES_TEST_PASSWORD=replace_with_unique_localprod_test_password
LOCALPROD_REDIS_PASSWORD=replace_with_unique_localprod_redis_password

# Hardened local-only Django verification. This mode is not staging or production.
LOCALPROD_DJANGO_SECRET_KEY=replace_with_a_unique_50_character_or_longer_local_secret
LOCALPROD_ALLOWED_HOSTS=tilecompany.localhost,localhost,127.0.0.1,[::1]
LOCALPROD_CSRF_TRUSTED_ORIGINS=https://tilecompany.localhost
# The password portion must represent LOCALPROD_REDIS_PASSWORD and be URL-encoded.
LOCALPROD_REDIS_URL=redis://:replace_with_url_encoded_localprod_redis_password@redis:6379/0
# Isolated Redis DB for Django test/performance runs; use the same URL-encoded
# password but DB 1, never the retained runtime DB 0.
LOCALPROD_REDIS_TEST_URL=redis://:replace_with_url_encoded_localprod_redis_password@redis:6379/1

# Set true only while intentionally testing the local online-payment simulator.
# It is false by default and is rejected by production settings.
LOCAL_PAYMENT_SIMULATOR_ENABLED=false
